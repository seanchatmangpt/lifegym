---
to: "src/lifegym_world_catalog.rs"
sparql:
  domains: |
    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
    SELECT ?id WHERE { ?domain a skos:Concept ; skos:prefLabel ?id . } ORDER BY ?id
  services: |
    PREFIX dcat: <http://www.w3.org/ns/dcat#>
    PREFIX dct: <http://purl.org/dc/terms/>
    SELECT ?id WHERE { ?service a dcat:DataService ; dct:identifier ?id . } ORDER BY ?id
---
//! Generated by ggen from the admitted LifeGym world profile. Do not hand edit.
pub const DOMAINS: &[&str] = &[
{% for row in domains -%}
    "{{ row.id }}",
{% endfor -%}
];
pub const SERVICES: &[&str] = &[
{% for row in services -%}
    "{{ row.id }}",
{% endfor -%}
];
pub fn domain_count() -> usize { DOMAINS.len() }
pub fn service_count() -> usize { SERVICES.len() }
